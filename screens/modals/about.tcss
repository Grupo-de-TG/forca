/* Estilos do Modal Sobre & Controles - Layout Fluido e Redimensionável */

.modal-dialog {
    width: 80%;
    max-width: 64;
    min-width: 36;
    height: auto;
    max-height: 85%;
    overflow-y: auto;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
    align: center middle;
}

.modal-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    width: 100%;
}

#about-text {
    height: auto;
    margin: 1 0;
    color: $text;
    width: 100%;
}

.modal-buttons {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin: 0 1;
}
