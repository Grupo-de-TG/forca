/* Estilos do Modal de Fim de Jogo */

.modal-dialog {
    width: 60;
    height: auto;
    background: $panel;
    border: thick $accent;
    padding: 1 2;
    align: center middle;
}

.modal-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

.modal-title.vitoria {
    color: $success;
}

.modal-title.derrota {
    color: $error;
}

.modal-palavra {
    text-align: center;
    margin-bottom: 1;
}

#modal-stats {
    background: $boost;
    padding: 1;
    border: round $secondary;
    margin-bottom: 1;
}

.modal-buttons {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin: 0 1;
}
