/* Estilos do Modal de Redefinição de Senha */

.modal-dialog {
    width: 80%;
    max-width: 60;
    min-width: 36;
    height: auto;
    max-height: 85%;
    overflow-y: auto;
    background: $panel;
    border: thick $warning;
    padding: 1 2;
    align: center middle;
}

.modal-title {
    text-align: center;
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
    width: 100%;
}

#reset-aviso {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
    width: 100%;
}

.reset-input {
    width: 100%;
    margin: 0 0 1 0;
    border: tall $secondary;
    background: $boost;
    color: $text;
}

.reset-input:focus {
    border: tall $warning;
}

#reset-status-msg {
    text-align: center;
    margin-bottom: 1;
    min-height: 1;
    width: 100%;
}

.modal-buttons {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin: 0 1;
}
