/* Estilos do Modal de Assinatura e Identificação de Jogador */

#player-select-container {
    align: center middle;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    padding: 1 2;
}

#player-select-box {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
    background: $panel;
    border: heavy $primary;
    padding: 1 2;
    align: center middle;
}

#player-select-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#player-select-title.vitoria {
    color: $success;
}

#player-select-title.derrota {
    color: $error;
}

.match-summary {
    background: $boost;
    padding: 1;
    border: round $secondary;
    margin-bottom: 1;
    width: 100%;
}

#player-select-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

.input-field {
    width: 100%;
    margin: 0 0 1 0;
    border: tall $secondary;
    background: $boost;
    color: $text;
}

.input-field:focus {
    border: tall $accent;
}

#player-status-msg {
    text-align: center;
    margin-bottom: 1;
    height: auto;
    min-height: 1;
    width: 100%;
}

#player-history-label {
    text-align: left;
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 0;
}

#player-list {
    width: 100%;
    height: 4;
    margin-bottom: 1;
    border: round $primary-muted;
    background: $boost;
}

#player-actions-row1, #player-actions-row2 {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

.player-btn {
    width: 1fr;
    height: 3;
    margin: 0 1;
}

.player-btn:focus {
    text-style: bold;
    border: tall $accent;
}


