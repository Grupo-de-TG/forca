/* Estilos Exclusivos da Tela de Menu - Layout Fluido e Redimensionável */

#menu-container {
    width: 85%;
    max-width: 74;
    min-width: 38;
    height: auto;
    max-height: 90%;
    overflow-y: auto;
    border: heavy $accent;
    background: $panel;
    padding: 1 2;
    align: center middle;
}

#menu-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

#menu-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
    width: 100%;
}

#menu-category-info {
    text-align: center;
    background: $boost;
    color: $warning;
    padding: 0 1;
    margin-bottom: 1;
    border: round $primary;
    width: 100%;
}

#menu-buttons {
    width: 100%;
    align: center middle;
}

.menu-btn {
    width: 80%;
    max-width: 48;
    min-width: 28;
    margin: 1 0;
}

.menu-btn:focus {
    border: heavy $accent;
    background: $accent-muted;
}
