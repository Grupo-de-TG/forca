/* Estilos Exclusivos da Tela de Categorias - Layout Fluido e Redimensionável */

#category-container {
    width: 85%;
    max-width: 72;
    min-width: 36;
    height: 85%;
    max-height: 90%;
    border: heavy $primary;
    background: $panel;
    padding: 1 2;
}

#category-list {
    width: 100%;
    height: 1fr;
    margin: 1 0;
    border: solid $secondary;
}

.modal-buttons {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin: 0 1;
}
