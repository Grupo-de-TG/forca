/* Estilos da Tela do Jogo da Forca - Proporção 40/60 (View / Teclado) */

#game-header {
    dock: top;
    height: 3;
    background: $boost;
    color: $accent;
    align: center middle;
    text-style: bold;
    border-bottom: solid $primary;
}

/* ========================================================= */
/* 1. LAYOUT HORIZONTAL (Proporção 40% View / 60% Teclado)   */
/* ========================================================= */
.layout-horizontal #game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 6fr; /* 40% esquerda (View), 60% direita (Teclado/Jogo) */
    padding: 1;
    overflow-y: auto;
}

.layout-horizontal #forca-panel {
    background: $panel;
    border: round $primary;
    padding: 1;
    align: center middle;
    height: 100%;
    width: 100%;
    min-width: 20;
}

.layout-horizontal #forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: 100%;
}

.layout-horizontal #vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    margin-top: 1;
    width: 100%;
}

.layout-horizontal #game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1 2;
    height: 100%;
    width: 100%;
    layout: vertical;
    align: center top;
    overflow-y: auto;
}

/* ========================================================= */
/* 2. LAYOUT VERTICAL (Proporção 40% View / 60% Teclado)     */
/* ========================================================= */
.layout-vertical #game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 1 2;
    grid-rows: 4fr 6fr; /* 40% topo (View da Forca), 60% base (Teclado/Jogo) */
    padding: 0 1;
    overflow-y: auto;
}

.layout-vertical #forca-panel {
    background: $panel;
    border: round $primary;
    padding: 0 1;
    align: center middle;
    height: 100%;
    width: 100%;
    layout: horizontal;
    overflow-y: auto;
}

.layout-vertical #forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: auto;
    margin-right: 3;
}

.layout-vertical #vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    width: auto;
}

.layout-vertical #game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1;
    height: 100%;
    width: 100%;
    layout: vertical;
    align: center top;
    overflow-y: auto;
}

/* ========================================================= */
/* ELEMENTOS COMUNS                                          */
/* ========================================================= */
#badge-categoria {
    color: $accent;
    text-style: bold;
    background: $boost;
    padding: 0 1;
    width: auto;
    margin-bottom: 1;
}

#palavra-secreta {
    text-align: center;
    text-style: bold;
    color: $success;
    background: $boost;
    border: double $success;
    padding: 1;
    margin: 1 0;
    width: 100%;
}

#status-mensagem {
    text-align: center;
    color: $warning;
    text-style: italic;
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    width: 100%;
}

#letras-historico {
    height: auto;
    width: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    background: $boost;
    padding: 1;
    border: solid $secondary;
    margin-bottom: 1;
}

.letras-label {
    text-style: bold;
}

#letras-certas-box {
    color: $success;
}

#letras-erradas-box {
    color: $error;
}

/* Teclado Virtual */
#teclado-container {
    height: auto;
    width: 100%;
    max-width: 62;
    align: center middle;
    margin-top: 1;
    padding: 1 0;
    background: $boost;
    border: round $primary;
}

.teclado-linha {
    height: auto;
    width: 100%;
    align: center middle;
}

.key-btn {
    min-width: 4;
    width: 5;
    height: 3;
    margin: 0 1;
    padding: 0;
    border: solid $secondary;
}

.key-btn:focus {
    border: heavy $warning;
    background: $warning;
    color: #000000;
    text-style: bold;
}

.key-btn.usada-certa {
    background: $success;
    color: #ffffff;
    border: solid $success-lighten-2;
}

.key-btn.usada-certa:focus {
    border: heavy $warning;
    background: $success-darken-1;
    color: $warning;
}

.key-btn.usada-errada {
    background: $error-darken-2;
    color: $text-muted;
    opacity: 60%;
    border: solid $error;
}

.key-btn.usada-errada:focus {
    border: heavy $warning;
    opacity: 90%;
}

/* Barra de Ações Inferior */
#game-actions {
    dock: bottom;
    height: 3;
    width: 100%;
    background: $boost;
    align: center middle;
    padding: 0 1;
}

.action-btn {
    margin: 0 1;
}
