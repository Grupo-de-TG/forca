/* Estilos da Tela do Jogo da Forca - 100% Teclado Físico & Proporção 40/60 */

#game-header {
    dock: top;
    height: 3;
    background: $boost;
    color: $accent;
    align: center middle;
    text-style: bold;
    border-bottom: solid $primary;
}

/* ========================================================= */
/* 1. LAYOUT HORIZONTAL (Proporção 40% View / 60% Jogo)      */
/* ========================================================= */
.layout-horizontal #game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 6fr; /* 40% esquerda (View Forca), 60% direita (Tema + Palavra + Entrada) */
    padding: 1;
    overflow-y: auto;
}

.layout-horizontal #forca-panel {
    background: $panel;
    border: round $primary;
    padding: 1;
    align: center middle;
    height: 100%;
    width: 100%;
    min-width: 20;
}

.layout-horizontal #forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: 100%;
}

.layout-horizontal #vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    margin-top: 1;
    width: 100%;
}

.layout-horizontal #game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1 2;
    height: 100%;
    width: 100%;
    layout: vertical;
    align: center top;
    overflow-y: auto;
}

/* ========================================================= */
/* 2. LAYOUT VERTICAL (Proporção 40% View / 60% Jogo)        */
/* ========================================================= */
.layout-vertical #game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 1 2;
    grid-rows: 4fr 6fr; /* 40% topo (View Forca), 60% base (Tema + Palavra + Entrada) */
    padding: 0 1;
    overflow-y: auto;
}

.layout-vertical #forca-panel {
    background: $panel;
    border: round $primary;
    padding: 0 1;
    align: center middle;
    height: 100%;
    width: 100%;
    layout: horizontal;
    overflow-y: auto;
}

.layout-vertical #forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: auto;
    margin-right: 3;
}

.layout-vertical #vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    width: auto;
}

.layout-vertical #game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1;
    height: 100%;
    width: 100%;
    layout: vertical;
    align: center top;
    overflow-y: auto;
}

/* ========================================================= */
/* CAIXA DE TEMA + PALAVRA (ENTRE A VIEW E O INSERT DE LETRAS)*/
/* ========================================================= */
#tema-palavra-container {
    height: auto;
    width: 100%;
    background: $boost;
    border: round $primary;
    padding: 1;
    margin-bottom: 1;
    align: center middle;
}

#badge-categoria {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#palavra-secreta {
    text-align: center;
    text-style: bold;
    color: $success;
    background: $panel;
    border: double $success;
    padding: 1;
    width: 100%;
}

/* ========================================================= */
/* PARTE DE INSERT DE LETRAS, STATUS E HISTÓRICO             */
/* ========================================================= */
#insert-letras-panel {
    height: auto;
    width: 100%;
    layout: vertical;
    align: center top;
}

/* Linha com Slot de Letra Centralizado */
#slot-letra-row {
    height: auto;
    width: 100%;
    align: center middle;
    margin: 1 0;
}

/* Slot Focável com Underline: Letra: _ */
LetterSlot {
    height: 3;
    width: auto;
    min-width: 20;
    content-align: center middle;
    text-align: center;
    border: round $secondary;
    background: $boost;
    padding: 0 2;
}

LetterSlot:focus {
    border: heavy $warning;
    background: $panel;
    color: $warning;
}

#status-mensagem {
    text-align: center;
    color: $warning;
    text-style: italic;
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    width: 100%;
}

/* Histórico de Letras */
#letras-historico {
    height: auto;
    width: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    background: $boost;
    padding: 1;
    border: solid $secondary;
    margin-bottom: 1;
}

.letras-label {
    text-style: bold;
}

#letras-certas-box {
    color: $success;
}

#letras-erradas-box {
    color: $error;
}

/* Barra de Ações Inferior - 3 botões dividindo a área igualmente (1fr cada) */
#game-actions {
    dock: bottom;
    height: 3;
    width: 100%;
    background: $boost;
    layout: horizontal;
    align: center middle;
    padding: 0 1;
}

.action-btn {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    text-align: center;
}

.action-btn:focus {
    border: heavy $warning;
    background: $warning-muted;
}
