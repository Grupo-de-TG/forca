/* Estilos Exclusivos da Tela do Jogo da Forca - Layout Fluido e Redimensionável */

#game-header {
    dock: top;
    height: 3;
    background: $boost;
    color: $accent;
    align: center middle;
    text-style: bold;
    border-bottom: solid $primary;
}

#game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 2fr;
    padding: 1;
    overflow-y: auto;
}

/* Painel Esquerdo: Forca ASCII (1fr) */
#forca-panel {
    background: $panel;
    border: round $primary;
    padding: 1;
    align: center middle;
    height: 100%;
    width: 100%;
    min-width: 20;
    overflow-y: auto;
}

#forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
    width: 100%;
}

#vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    margin-top: 1;
    width: 100%;
}

/* Painel Direito: Conteúdo e Jogo (2fr) */
#game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1 2;
    height: 100%;
    width: 100%;
    layout: vertical;
    align: center top;
    overflow-y: auto;
}

#badge-categoria {
    color: $accent;
    text-style: bold;
    background: $boost;
    padding: 0 1;
    width: auto;
    margin-bottom: 1;
}

#palavra-secreta {
    text-align: center;
    text-style: bold;
    color: $success;
    background: $boost;
    border: double $success;
    padding: 1;
    margin: 1 0;
    width: 100%;
}

#status-mensagem {
    text-align: center;
    color: $warning;
    text-style: italic;
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    width: 100%;
}

#letras-historico {
    height: auto;
    width: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    background: $boost;
    padding: 1;
    border: solid $secondary;
    margin-bottom: 1;
}

.letras-label {
    text-style: bold;
}

#letras-certas-box {
    color: $success;
}

#letras-erradas-box {
    color: $error;
}

/* Teclado Virtual Fluido */
#teclado-container {
    height: auto;
    width: 100%;
    max-width: 62;
    align: center middle;
    margin-top: 1;
    padding: 1 0;
    background: $boost;
    border: round $primary;
}

.teclado-linha {
    height: auto;
    width: 100%;
    align: center middle;
}

.key-btn {
    min-width: 4;
    width: 5;
    height: 3;
    margin: 0 1;
    padding: 0;
    border: solid $secondary;
}

/* Tecla focada/selecionada */
.key-btn:focus {
    border: heavy $warning;
    background: $warning;
    color: #000000;
    text-style: bold;
}

.key-btn.usada-certa {
    background: $success;
    color: #ffffff;
    border: solid $success-lighten-2;
}

.key-btn.usada-certa:focus {
    border: heavy $warning;
    background: $success-darken-1;
    color: $warning;
}

.key-btn.usada-errada {
    background: $error-darken-2;
    color: $text-muted;
    opacity: 60%;
    border: solid $error;
}

.key-btn.usada-errada:focus {
    border: heavy $warning;
    opacity: 90%;
}

/* Barra de Ações Inferior */
#game-actions {
    dock: bottom;
    height: 3;
    width: 100%;
    background: $boost;
    align: center middle;
    padding: 0 1;
}

.action-btn {
    margin: 0 1;
}
