/* Estilos da TUI do Jogo da Forca - SysOps Edition */

Screen {
    background: $surface;
    color: $text;
    align: center middle;
}

/* Foco visível com alto contraste para navegação por setas (Sem Mouse) */
Button:focus {
    border: heavy $warning;
    background: $warning-muted;
    text-style: bold;
    color: $text;
}

OptionList:focus {
    border: heavy $accent;
}

Input:focus {
    border: heavy $warning;
    background: $boost;
}

/* ================= MENU PRINCIPAL ================= */
#menu-container {
    width: 72;
    height: auto;
    border: heavy $accent;
    background: $panel;
    padding: 1 2;
    align: center middle;
}

#menu-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#menu-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#menu-category-info {
    text-align: center;
    background: $boost;
    color: $warning;
    padding: 0 1;
    margin-bottom: 1;
    border: round $primary;
}

#menu-buttons {
    width: 100%;
    align: center middle;
}

.menu-btn {
    width: 46;
    margin: 1 0;
}

.menu-btn:focus {
    border: heavy $accent;
    background: $accent-muted;
}

/* ================= SELEÇÃO DE CATEGORIAS ================= */
#category-container {
    width: 68;
    height: 85%;
    border: heavy $primary;
    background: $panel;
    padding: 1 2;
}

#category-list {
    height: 1fr;
    margin: 1 0;
    border: solid $secondary;
}

/* ================= TELA DO JOGO ================= */
#game-header {
    dock: top;
    height: 3;
    background: $boost;
    color: $accent;
    align: center middle;
    text-style: bold;
    border-bottom: solid $primary;
}

#game-body {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 32 1fr;
    padding: 1;
}

/* Painel Esquerdo: Forca */
#forca-panel {
    background: $panel;
    border: round $primary;
    padding: 1;
    align: center middle;
    height: 100%;
}

#forca-art {
    color: $warning;
    text-style: bold;
    text-align: center;
}

#vidas-display {
    text-align: center;
    color: $error;
    text-style: bold;
    margin-top: 1;
}

/* Painel Direito: Conteúdo e Jogo */
#game-main-panel {
    background: $panel;
    border: round $accent;
    padding: 1 2;
    height: 100%;
    layout: vertical;
    align: center top;
}

#badge-categoria {
    color: $accent;
    text-style: bold;
    background: $boost;
    padding: 0 1;
    width: auto;
    margin-bottom: 1;
}

#palavra-secreta {
    text-align: center;
    text-style: bold;
    color: $success;
    background: $boost;
    border: double $success;
    padding: 1;
    margin: 1 0;
    width: 100%;
}

#status-mensagem {
    text-align: center;
    color: $warning;
    text-style: italic;
    height: 2;
    margin-bottom: 1;
    width: 100%;
}

#letras-historico {
    height: auto;
    width: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    background: $boost;
    padding: 1;
    border: solid $secondary;
    margin-bottom: 1;
}

.letras-label {
    text-style: bold;
}

#letras-certas-box {
    color: $success;
}

#letras-erradas-box {
    color: $error;
}

/* Teclado Virtual com Navegação por Setas */
#teclado-container {
    height: auto;
    width: 100%;
    align: center middle;
    margin-top: 1;
    padding: 1 0;
    background: $boost;
    border: round $primary;
}

.teclado-linha {
    height: auto;
    align: center middle;
}

.key-btn {
    min-width: 4;
    width: 5;
    height: 3;
    margin: 0 1;
    padding: 0;
    border: solid $secondary;
}

/* Tecla com foco / selecionada para pensar */
.key-btn:focus {
    border: heavy $warning;
    background: $warning;
    color: #000000;
    text-style: bold;
}

.key-btn.usada-certa {
    background: $success;
    color: #ffffff;
    border: solid $success-lighten-2;
}

.key-btn.usada-certa:focus {
    border: heavy $warning;
    background: $success-darken-1;
    color: $warning;
}

.key-btn.usada-errada {
    background: $error-darken-2;
    color: $text-muted;
    opacity: 60%;
    border: solid $error;
}

.key-btn.usada-errada:focus {
    border: heavy $warning;
    opacity: 90%;
}

/* Barra de Ações Inferior */
#game-actions {
    dock: bottom;
    height: 3;
    background: $boost;
    align: center middle;
    padding: 0 1;
}

.action-btn {
    margin: 0 1;
}

/* ================= MODAIS ================= */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.modal-dialog {
    width: 60;
    height: auto;
    background: $panel;
    border: thick $accent;
    padding: 1 2;
    align: center middle;
}

.modal-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

.modal-title.vitoria {
    color: $success;
}

.modal-title.derrota {
    color: $error;
}

.modal-buttons {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin: 0 1;
}

#chute-input {
    margin: 1 0;
}

#about-text {
    height: auto;
    margin: 1 0;
    color: $text;
}
